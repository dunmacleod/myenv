  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Unlike a fixed running case, this module's project is built on a business problem you choose yourself. It might be an internal support agent for a firm you've worked at, a research assistant for a domain you know, an ops-side triage system, a specialist advisor \u2014 the shape doesn't matter as much as the ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Unlike a fixed running case, this module's project is built on a business problem you choose yourself. It might be an internal support agent for a firm you've worked at, a research assistant for a domain you know, an ops-side triage system, a specialist advisor \u2014 the shape doesn't matter as much as the ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "specificity",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": true,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "specificity",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": ". A vague brief produces a vague redesign; a narrow, real brief produces a defensible one.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
