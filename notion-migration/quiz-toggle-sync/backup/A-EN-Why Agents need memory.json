  "type": "heading_2",
  "heading_2": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Why language models are stateless by default",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Why language models are stateless by default",
     "href": null
    }
   ],
   "is_toggleable": false,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "67c723e1-058b-4c05-bec6-b6fb6b033892",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8037-b38c-db07ac299fae"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-20T09:36:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A large language model (LLM) processes the exact text it receives in a given request, generates a response, and immediately discards everything. It has no built-in record of previous messages. The next time a user sends a message, the model treats it as the very first interaction it has ever had with that person.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "A large language model (LLM) processes the exact text it receives in a given request, generates a response, and immediately discards everything. It has no built-in record of previous messages. The next time a user sends a message, the model treats it as the very first interaction it has ever had with that person.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "626f99fd-3f8d-4221-ba0a-473971467ecf",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8037-b38c-db07ac299fae"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-23T17:24:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "This is called being ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "This is called being ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "stateless",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "stateless",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": ". Stateless means no persistent record of what has happened before. Every request is isolated, processed independently, and forgotten the moment a response is generated. This is the default way of how large language models operate. The architecture is designed for single-turn interactions, not for ongoing business workflows.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": ". Stateless means no persistent record of what has happened before. Every request is isolated, processed independently, and forgotten the moment a response is generated. This is the default way of how large language models operate. The architecture is designed for single-turn interactions, not for ongoing business workflows.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "baba37a8-b5e2-42c4-b66d-437f17ab9733",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8037-b38c-db07ac299fae"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-23T17:24:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The consequence for Contigo is straightforward. Every time a client sends a new message, the agent starts from scratch. It has no access to what was said five seconds ago, let alone five days ago. It cannot track progress, cannot avoid redundant questions, and cannot build on any earlier context.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The consequence for Contigo is straightforward. Every time a client sends a new message, the agent starts from scratch. It has no access to what was said five seconds ago, let alone five days ago. It cannot track progress, cannot avoid redundant questions, and cannot build on any earlier context.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
