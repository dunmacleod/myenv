  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "This pattern repeats across any multi-turn workflow such as loan applications, compliance document requests, and onboarding sequences. Any process that requires more than one exchange is compromised the moment memory is absent.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
