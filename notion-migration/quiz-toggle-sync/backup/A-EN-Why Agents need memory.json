  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The first week goes badly. Clients submit their account numbers, then get asked to repeat them two messages later. Loan officers receive incomplete summaries because the agent forgot earlier details. One client closes their account after being asked for the same document three times in a single conversation.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
