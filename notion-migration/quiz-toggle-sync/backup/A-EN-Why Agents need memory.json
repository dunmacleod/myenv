  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The problem is not the language model. The problem is not the prompts. The problem is that the agent has no memory. Without memory, no amount of intelligence makes a business agent reliable.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The problem is not the language model. The problem is not the prompts. The problem is that the agent has no memory. Without memory, no amount of intelligence makes a business agent reliable.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
