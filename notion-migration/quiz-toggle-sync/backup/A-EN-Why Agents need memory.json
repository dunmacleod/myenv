 {
  "object": "block",
  "id": "c911a5a2-53ec-4a44-83f6-41ad5ad9924b",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8037-b38c-db07ac299fae"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-20T09:36:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Adding a memory component gives the agent access to what has already been said. The conversation history is stored outside the model and injected back into each new prompt, so the model can reason about the full context rather than just the latest message. This is what makes multi-turn business conversations possible.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Adding a memory component gives the agent access to what has already been said. The conversation history is stored outside the model and injected back into each new prompt, so the model can reason about the full context rather than just the latest message. This is what makes multi-turn business conversations possible.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
