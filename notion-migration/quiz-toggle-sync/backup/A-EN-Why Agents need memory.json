   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Contigo GmbH is a Munich-based financial services firm that operates across Germany, Austria, and the Netherlands. They have just deployed an AI support agent to handle client queries about account management, loan applications, and document submissions.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Contigo GmbH is a Munich-based financial services firm that operates across Germany, Austria, and the Netherlands. They have just deployed an AI support agent to handle client queries about account management, loan applications, and document submissions.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
