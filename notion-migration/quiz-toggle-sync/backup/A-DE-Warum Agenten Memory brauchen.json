  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Contigo GmbH ist ein Finanzdienstleister mit Sitz in M\u00fcnchen, der in Deutschland, \u00d6sterreich und den Niederlanden t\u00e4tig ist. Das Unternehmen hat gerade einen AI-Support-Agenten eingef\u00fchrt, der Kundenanfragen zu Kontoverwaltung, Kreditantr\u00e4gen und Dokumenteneinreichungen bearbeiten soll.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Contigo GmbH ist ein Finanzdienstleister mit Sitz in M\u00fcnchen, der in Deutschland, \u00d6sterreich und den Niederlanden t\u00e4tig ist. Das Unternehmen hat gerade einen AI-Support-Agenten eingef\u00fchrt, der Kundenanfragen zu Kontoverwaltung, Kreditantr\u00e4gen und Dokumenteneinreichungen bearbeiten soll.",
     "href": null
