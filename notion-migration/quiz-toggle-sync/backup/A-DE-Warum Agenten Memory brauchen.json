  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Schauen wir uns ein Beispiel an. Ein Contigo-Kunde m\u00f6chte seine Rechnungsadresse aktualisieren. Das Gespr\u00e4ch k\u00f6nnte so ablaufen:",
      "link": null
     },
     "annotations": {
      "bold": false,
