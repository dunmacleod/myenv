  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Das Problem ist nicht das Sprachmodell. Das Problem sind nicht die Prompts. Das Problem ist, dass der Agent kein Memory hat. Ohne Ged\u00e4chtnis kann selbst ein intelligenter Agent nicht zuverl\u00e4ssig arbeiten.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Das Problem ist nicht das Sprachmodell. Das Problem sind nicht die Prompts. Das Problem ist, dass der Agent kein Memory hat. Ohne Ged\u00e4chtnis kann selbst ein intelligenter Agent nicht zuverl\u00e4ssig arbeiten.",
     "href": null
    }
   ],
