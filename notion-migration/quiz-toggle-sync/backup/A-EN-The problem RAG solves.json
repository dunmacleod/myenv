 {
  "object": "block",
  "id": "f4cd3e71-f294-40ea-9e3c-42dae3683994",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8098-9a75-d90eec3aca5c"
  },
  "created_time": "2026-05-22T01:59:00.000Z",
  "last_edited_time": "2026-05-22T01:59:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Retrieval-Augmented Generation (RAG) is an architectural pattern that addresses this problem directly. Instead of relying on the model's frozen internal knowledge, RAG gives the agent access to an external, up-to-date knowledge base at query time.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Retrieval-Augmented Generation (RAG) is an architectural pattern that addresses this problem directly. Instead of relying on the model's frozen internal knowledge, RAG gives the agent access to an external, up-to-date knowledge base at query time.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "82e30dc8-fce9-4532-ad33-c00ddce37b1b",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8098-9a75-d90eec3aca5c"
  },
  "created_time": "2026-05-22T01:59:00.000Z",
  "last_edited_time": "2026-05-22T01:59:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The process works in three steps. When a client submits a query, the system searches an external database to retrieve document chunks that are relevant to that query. Those chunks are appended to the prompt as context. The language model then generates its response based on that retrieved context rather than relying on its general training.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The process works in three steps. When a client submits a query, the system searches an external database to retrieve document chunks that are relevant to that query. Those chunks are appended to the prompt as context. The language model then generates its response based on that retrieved context rather than relying on its general training.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
