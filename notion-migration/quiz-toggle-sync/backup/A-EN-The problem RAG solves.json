 {
  "object": "block",
  "id": "9e349282-8779-4a1e-b778-20c4fcaed250",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8098-9a75-d90eec3aca5c"
  },
  "created_time": "2026-05-22T01:59:00.000Z",
  "last_edited_time": "2026-05-22T01:59:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A large language model is trained on a vast body of text up to a fixed point in time. After training, its internal knowledge is frozen. It cannot access information that postdates its training cutoff, it has no visibility into private or proprietary business data, and it has no mechanism for knowing what it does not know.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "A large language model is trained on a vast body of text up to a fixed point in time. After training, its internal knowledge is frozen. It cannot access information that postdates its training cutoff, it has no visibility into private or proprietary business data, and it has no mechanism for knowing what it does not know.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "69ac2a5e-5e8d-4d07-8517-15009ecb78e9",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8098-9a75-d90eec3aca5c"
  },
  "created_time": "2026-05-22T01:59:00.000Z",
  "last_edited_time": "2026-05-23T23:57:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "When a question falls outside what the model genuinely knows, it does not stop and say so. It generates the most plausible-sounding continuation of the prompt it can produce. The result is a confident, fluent, and potentially fabricated answer; known as hallucination.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "When a question falls outside what the model genuinely knows, it does not stop and say so. It generates the most plausible-sounding continuation of the prompt it can produce. The result is a confident, fluent, and potentially fabricated answer; known as hallucination.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "8373776d-b7b6-43d4-afc7-8b080545fe2e",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-8098-9a75-d90eec3aca5c"
  },
  "created_time": "2026-05-22T01:59:00.000Z",
  "last_edited_time": "2026-05-22T01:59:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "For a consumer chatbot, hallucination is an embarrassment. For a financial services agent operating under EU regulatory oversight, it is a liability. Contigo cannot deploy an agent that invents loan terms, fabricates compliance thresholds, or misquotes product conditions to clients.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "For a consumer chatbot, hallucination is an embarrassment. For a financial services agent operating under EU regulatory oversight, it is a liability. Contigo cannot deploy an agent that invents loan terms, fabricates compliance thresholds, or misquotes product conditions to clients.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
