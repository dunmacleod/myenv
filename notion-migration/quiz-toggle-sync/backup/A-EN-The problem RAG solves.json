  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The result is an agent that answers from evidence rather than from approximation. When a Contigo client asks about the SME loan limit, the agent retrieves the current product documentation, reads the actual figure, and responds accurately. When the information is not in the knowledge base, the agent can be instructed to say so explicitly rather than fabricating an answer.",
      "link": null
     },
     "annotations": {
