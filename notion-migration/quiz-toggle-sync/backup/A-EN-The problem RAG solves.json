  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A client asks about the maximum loan amount available under Contigo's SME financing programme. The agent cites a figure from a general financial services context it encountered during training. The actual Contigo limit is different. The client proceeds on the basis of incorrect information. The compliance team flags the interaction as a serious incident.",
      "link": null
     },
