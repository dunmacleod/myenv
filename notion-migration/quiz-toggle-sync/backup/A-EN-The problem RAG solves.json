  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Contigo GmbH's support agent has memory, session isolation, and a well-designed retention policy. In multi-turn conversations about things the agent already knows from its training, it performs reliably. But when clients ask about Contigo's specific loan products, current interest rates, or internal compliance procedures, something goes wrong.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Contigo GmbH's support agent has memory, session isolation, and a well-designed retention policy. In multi-turn conversations about things the agent already knows from its training, it performs reliably. But when clients ask about Contigo's specific loan products, current interest rates, or internal compliance procedures, something goes wrong.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
