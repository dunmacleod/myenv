 {
  "object": "block",
  "id": "108c3b21-87b2-4f8f-a88a-ffb460cb296d",
  "parent": {
   "type": "page_id",
   "page_id": "37794183-19f3-8015-8a0a-f7f2776522ac"
  },
  "created_time": "2026-06-07T08:44:00.000Z",
  "last_edited_time": "2026-06-07T08:44:00.000Z",
  "created_by": {
   "object": "user",
   "id": "114d872b-594c-8174-9474-0002954cf668"
  },
  "last_edited_by": {
   "object": "user",
   "id": "114d872b-594c-8174-9474-0002954cf668"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Langzeit-Memory speichert Informationen \u00fcber die Grenzen einer einzelnen Session hinaus. Statt sich auf das Context Window zu verlassen, schreibt Langzeit-Memory wichtige Fakten in eine externe Datenbank. Das kann eine relationale Datenbank, ein Vector Store oder ein schneller Key-Value Store sein. Wenn ein Nutzer zur\u00fcckkehrt, fragt der Agent diese Datenbank ab, ruft relevante Informationen ab und injiziert sie in die neue Session, bevor das Gespr\u00e4ch beginnt.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Langzeit-Memory speichert Informationen \u00fcber die Grenzen einer einzelnen Session hinaus. Statt sich auf das Context Window zu verlassen, schreibt Langzeit-Memory wichtige Fakten in eine externe Datenbank. Das kann eine relationale Datenbank, ein Vector Store oder ein schneller Key-Value Store sein. Wenn ein Nutzer zur\u00fcckkehrt, fragt der Agent diese Datenbank ab, ruft relevante Informationen ab und injiziert sie in die neue Session, bevor das Gespr\u00e4ch beginnt.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "ce2e0575-fe96-48d3-a179-fba6ca8030b9",
  "parent": {
   "type": "page_id",
   "page_id": "37794183-19f3-8015-8a0a-f7f2776522ac"
  },
