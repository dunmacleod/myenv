  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Das System arbeitet in drei Schritten. Geht eine Kundenanfrage ein, durchsucht das System die Datenbank nach passenden Chunks. Es f\u00fcgt diese Textbausteine als Kontext in den Prompt ein. Das Sprachmodell generiert seine Antwort nun auf Basis dieser gelieferten Fakten statt aus dem allgemeinen Trainingsspeicher.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Das System arbeitet in drei Schritten. Geht eine Kundenanfrage ein, durchsucht das System die Datenbank nach passenden Chunks. Es f\u00fcgt diese Textbausteine als Kontext in den Prompt ein. Das Sprachmodell generiert seine Antwort nun auf Basis dieser gelieferten Fakten statt aus dem allgemeinen Trainingsspeicher.",
     "href": null
    }
   ],
