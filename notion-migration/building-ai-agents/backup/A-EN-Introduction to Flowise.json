      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Chatflow",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": " is the primary environment for single-agent systems. It supports the main building blocks you'll learn to use throughout this course: chaining conversation steps together (conversational chains), letting an agent answer from your own documents (a pattern called RAG), the kind of memory you just learned about, and connecting agents to external tools. You'll get a dedicated lesson on each \u2014 no need to recognise the names yet.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
