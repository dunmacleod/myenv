  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Flowise is an open-source, low-code visual builder for large language model applications and AI agents. It was developed to make the construction of LLM-powered systems accessible to developers who understand the problem they are solving without needing to write framework-level integration code from scratch. ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Flowise is an open-source, low-code visual builder for large language model applications and AI agents. It was developed to make the construction of LLM-powered systems accessible to developers who understand the problem they are solving without needing to write framework-level integration code from scratch. ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "Flowise is available in two main ways: as a self-hosted application or as Flowise Cloud. In this course, you will use the self-hosted version of ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Flowise is available in two main ways: as a self-hosted application or as Flowise Cloud. In this course, you will use the self-hosted version of ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "Flowise",
      "link": null
     },
