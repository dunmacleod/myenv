  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Meridian Consulting is a mid-sized professional services firm. Consultants spend a chunk of every week digging through internal handbooks, policy documents, and live engagement data to answer their own procedural questions \u2014 \"what's our sub-contracting policy for public-sector work?\", \"what stage is the Kessler engagement at?\", \"who signs off on scope changes over \u20ac50k?\".",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Meridian Consulting is a mid-sized professional services firm. Consultants spend a chunk of every week digging through internal handbooks, policy documents, and live engagement data to answer their own procedural questions \u2014 \"what's our sub-contracting policy for public-sector work?\", \"what stage is the Kessler engagement at?\", \"who signs off on scope changes over \u20ac50k?\".",
     "href": null
    }
   ],
   "icon": null,
