 {
  "object": "block",
  "id": "2bf733c1-3b57-435e-961d-fa5c954fca27",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-80ea-a97f-cfbecf83d649"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-23T17:36:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Short-term memory, also called session context or working memory, tracks what is happening in the current active conversation. As the user and agent exchange messages, the dialogue is held in the model's ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Short-term memory, also called session context or working memory, tracks what is happening in the current active conversation. As the user and agent exchange messages, the dialogue is held in the model's ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "context window",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "context window",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": " (A total amount of text the model can process at once) and injected into each new prompt so the model can reason across turns.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": " (A total amount of text the model can process at once) and injected into each new prompt so the model can reason across turns.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
