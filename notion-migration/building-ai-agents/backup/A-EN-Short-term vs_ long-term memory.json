  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "This memory is ",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "This memory is ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "ephemeral",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "ephemeral",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": ". It exists only for the duration of the active session. The moment the session ends, the working memory is wiped entirely. Nothing carries over to the next conversation.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": ". It exists only for the duration of the active session. The moment the session ends, the working memory is wiped entirely. Nothing carries over to the next conversation.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
