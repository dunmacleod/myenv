 {
  "object": "block",
  "id": "daf4506f-9baa-4775-8579-bfdaf1cb3722",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-80ea-a97f-cfbecf83d649"
  },
  "created_time": "2026-05-20T09:36:00.000Z",
  "last_edited_time": "2026-05-20T09:36:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Short-term memory is the right tool for tasks that only require continuity within a single conversation: tracking what has already been submitted, managing a multi-step process, or avoiding redundant questions mid-session. It is fast, requires no external infrastructure, and works out of the box in most agent frameworks.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Short-term memory is the right tool for tasks that only require continuity within a single conversation: tracking what has already been submitted, managing a multi-step process, or avoiding redundant questions mid-session. It is fast, requires no external infrastructure, and works out of the box in most agent frameworks.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
