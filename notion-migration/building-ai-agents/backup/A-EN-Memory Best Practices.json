  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Long-term memory databases grow without bound unless actively managed. Information that was relevant six months ago may be stale, inaccurate, or simply no longer applicable to the client's current situation.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Long-term memory databases grow without bound unless actively managed. Information that was relevant six months ago may be stale, inaccurate, or simply no longer applicable to the client's current situation.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "39595ce6-3654-4ee6-8158-9edfff343bfb",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-80ce-af6c-fc32055e0f26"
  },
  "created_time": "2026-05-20T09:39:00.000Z",
