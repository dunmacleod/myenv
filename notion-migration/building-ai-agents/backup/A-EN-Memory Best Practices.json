 {
  "object": "block",
  "id": "f09a81b4-f464-4a05-a7c3-b61bb7f513c2",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-80ce-af6c-fc32055e0f26"
  },
  "created_time": "2026-05-20T09:39:00.000Z",
  "last_edited_time": "2026-05-20T09:39:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Memory poisoning occurs when incorrect information is stored and then retrieved in future sessions as if it were true. This can happen when a client provides inaccurate details, when the language model hallucinates a fact that gets written to memory, or when new information contradicts something stored previously.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Memory poisoning occurs when incorrect information is stored and then retrieved in future sessions as if it were true. This can happen when a client provides inaccurate details, when the language model hallucinates a fact that gets written to memory, or when new information contradicts something stored previously.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "382454de-5ed6-4314-998d-8de5e892bb39",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-80ce-af6c-fc32055e0f26"
  },
  "created_time": "2026-05-20T09:39:00.000Z",
  "last_edited_time": "2026-05-20T09:39:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Define a conflict resolution rule before this becomes a problem. When new information contradicts an existing memory entry, the agent needs a clear instruction for how to proceed \u2014 whether to overwrite the old entry, flag the conflict for human review, or ask the client to confirm which version is correct.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Define a conflict resolution rule before this becomes a problem. When new information contradicts an existing memory entry, the agent needs a clear instruction for how to proceed \u2014 whether to overwrite the old entry, flag the conflict for human review, or ask the client to confirm which version is correct.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
