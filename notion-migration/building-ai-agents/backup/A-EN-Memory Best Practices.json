  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Implement a time-based decay policy that automatically deprioritises or removes memory entries after a defined period. What that period is depends on the use case. This is a preference for written communication is likely to remain valid for years, while a note about a temporary account restriction may be irrelevant within weeks.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Implement a time-based decay policy that automatically deprioritises or removes memory entries after a defined period. What that period is depends on the use case. This is a preference for written communication is likely to remain valid for years, while a note about a temporary account restriction may be irrelevant within weeks.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
