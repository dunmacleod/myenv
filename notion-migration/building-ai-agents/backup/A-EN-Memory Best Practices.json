     "rich_text": [
      {
       "type": "text",
       "text": {
        "content": "Good memory design is as much about what the agent forgets as what it remembers. Storing the minimum necessary, protecting sensitive data, managing database growth, and handling conflicting information are the four practices that separate a memory configuration that works in a demo from one that holds up in production.",
        "link": null
       },
       "annotations": {
        "bold": false,
        "italic": false,
