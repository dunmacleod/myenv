  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Der Agent von Meridian Consulting steht kurz vor dem letzten Feinschliff. Das Canvas ist konfiguriert. Das Retrieval liefert fundierte Antworten. Die Tools sind verbunden. Der System-Prompt steuert das Verhalten. Der Agent funktioniert. Aber funktionieren hei\u00dft noch lange nicht perfekt.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Der Agent von Meridian Consulting steht kurz vor dem letzten Feinschliff. Das Canvas ist konfiguriert. Das Retrieval liefert fundierte Antworten. Die Tools sind verbunden. Der System-Prompt steuert das Verhalten. Der Agent funktioniert. Aber funktionieren hei\u00dft noch lange nicht perfekt.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
