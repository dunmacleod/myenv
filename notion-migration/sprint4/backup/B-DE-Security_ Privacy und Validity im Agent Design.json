   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Meridians Agent wird in seinem System Prompt angewiesen, niemals Gehaltsinformationen offenzulegen. Ein Consultant sendet einen sorgf\u00e4ltig konstruierten Prompt, der den Agenten dazu bringt, \u00fcber diese Instruction hinaus reasoning zu betreiben und Gehaltszahlen in seine Response aufzunehmen. Welche Architectural Control h\u00e4tte dies am zuverl\u00e4ssigsten verhindert?",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Meridians Agent wird in seinem System Prompt angewiesen, niemals Gehaltsinformationen offenzulegen. Ein Consultant sendet einen sorgf\u00e4ltig konstruierten Prompt, der den Agenten dazu bringt, \u00fcber diese Instruction hinaus reasoning zu betreiben und Gehaltszahlen in seine Response aufzunehmen. Welche Architectural Control h\u00e4tte dies am zuverl\u00e4ssigsten verhindert?",
