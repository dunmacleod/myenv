  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Their constraints are as follows. They self-host all infrastructure for data privacy reasons and cannot use any managed platform that processes their data externally. Their existing codebase is entirely Python. They require the ability to modify the underlying retrieval logic of their RAG pipeline beyond what any visual node exposes by default. Their budget is engineering time.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Their constraints are as follows. They self-host all infrastructure for data privacy reasons and cannot use any managed platform that processes their data externally. Their existing codebase is entirely Python. They require the ability to modify the underlying retrieval logic of their RAG pipeline beyond what any visual node exposes by default. Their budget is engineering time.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
