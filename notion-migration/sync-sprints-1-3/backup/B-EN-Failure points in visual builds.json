 {
  "object": "block",
  "id": "0bbf65b5-4fff-4289-915b-9922b835fd0d",
  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-801f-9c87-f2dbf7041ddb"
  },
  "created_time": "2026-06-12T01:44:00.000Z",
  "last_edited_time": "2026-06-12T01:44:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Failures rarely stay contained within the node where they originate. A retrieval failure produces incorrect content that Agent Node A reasons from. That response enters session memory. The next turn injects it as established fact. Each step compounds the error. This is why production failures are more severe than isolated testing reveals. Individual nodes tested against clean inputs do not surface the failure modes that emerge from their interaction.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Failures rarely stay contained within the node where they originate. A retrieval failure produces incorrect content that Agent Node A reasons from. That response enters session memory. The next turn injects it as established fact. Each step compounds the error. This is why production failures are more severe than isolated testing reveals. Individual nodes tested against clean inputs do not surface the failure modes that emerge from their interaction.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
