  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The Document Store returns semantically adjacent chunks that are close to the query topic but not containing the information needed to answer correctly. The Agent Node treats them as sufficient and generates a response grounded in the wrong material. No node crashed. The failure is semantic, visible only when the response is compared against the actual document content.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The Document Store returns semantically adjacent chunks that are close to the query topic but not containing the information needed to answer correctly. The Agent Node treats them as sufficient and generates a response grounded in the wrong material. No node crashed. The failure is semantic, visible only when the response is compared against the actual document content.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
