  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Context bleed occurs when detail from an earlier account discussion carries into a later one by misattributing action items or applying a constraint from one engagement to another. As conversation length grows, the probability increases and routing decisions degrade.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
