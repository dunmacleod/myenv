  "parent": {
   "type": "page_id",
   "page_id": "36694183-19f3-801f-9c87-f2dbf7041ddb"
  },
  "created_time": "2026-05-22T02:36:00.000Z",
  "last_edited_time": "2026-06-15T12:43:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "114d872b-594c-8174-9474-0002954cf668"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The system prompt governs the agent's behaviour. When it is ambiguous or incomplete, the agent fills the gap with Gemini's general training data. The response sounds authoritative. It is wrong. No error is raised. The agent simply produces a confident incorrect answer that looks identical to a correct one.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The system prompt governs the agent's behaviour. When it is ambiguous or incomplete, the agent fills the gap with Gemini's general training data. The response sounds authoritative. It is wrong. No error is raised. The agent simply produces a confident incorrect answer that looks identical to a correct one.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
