    "type": "paragraph",
    "paragraph": {
     "rich_text": [
      {
       "type": "text",
       "text": {
        "content": "Agentflow-v2-Builds scheitern an den Verbindungen zwischen den Nodes. Ein Prompt-Fehler produziert selbstbewusste, falsche Antworten. Ein Retrieval-Fehler vergiftet das Context Window. Ein Tool-Fehler l\u00f6st Loops oder eine Kontamination des Flow State aus.",
        "link": null
       },
       "annotations": {
        "bold": false,
        "italic": false,
        "strikethrough": false,
        "underline": false,
        "code": false,
        "color": "default"
       },
