      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": " steht sofort jedem Node zur Verf\u00fcgung, der im weiteren Verlauf auf diesen Key zugreift. Die Kontamination ist strukturell und passiert sofort.",
     "href": null
    }
