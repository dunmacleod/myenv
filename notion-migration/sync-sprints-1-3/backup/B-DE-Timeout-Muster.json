  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Gutes Timeout-Handling bedeutet nicht nur, eine Zahl zu erh\u00f6hen. Es bedeutet zu verstehen, wie lange der Workflow realistischerweise dauern sollte, wo der Timeout erzwungen wird und was passieren soll, wenn Arbeit l\u00e4nger dauert als erwartet.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Gutes Timeout-Handling bedeutet nicht nur, eine Zahl zu erh\u00f6hen. Es bedeutet zu verstehen, wie lange der Workflow realistischerweise dauern sollte, wo der Timeout erzwungen wird und was passieren soll, wenn Arbeit l\u00e4nger dauert als erwartet.",
     "href": null
