 },
 {
  "object": "block",
  "id": "e603459e-ded5-49b6-99ca-6fd898a0dd5a",
  "parent": {
   "type": "page_id",
   "page_id": "2e194183-19f3-8365-b5f1-015ca1e3434b"
  },
  "created_time": "2026-07-05T22:54:00.000Z",
  "last_edited_time": "2026-07-05T22:54:00.000Z",
  "created_by": {
   "object": "user",
   "id": "14cd872b-594c-81d9-ac6e-0002007063d3"
  },
  "last_edited_by": {
   "object": "user",
   "id": "14cd872b-594c-81d9-ac6e-0002007063d3"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Stell dir einen Flowise-Agenten vor, der hinter einem Cloud-Proxy geschaltet ist. Geht eine Anfrage ein, reicht der Proxy diese an Flowise weiter, woraufhin die Antwortgenerierung startet. Wenn der Proxy nun ein Timeout von 30 Sekunden besitzt, kappt er nach Ablauf dieser Frist die Verbindung.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Stell dir einen Flowise-Agenten vor, der hinter einem Cloud-Proxy geschaltet ist. Geht eine Anfrage ein, reicht der Proxy diese an Flowise weiter, woraufhin die Antwortgenerierung startet. Wenn der Proxy nun ein Timeout von 30 Sekunden besitzt, kappt er nach Ablauf dieser Frist die Verbindung.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "61673a9f-18b5-4aac-a5d9-f1c6c8507d9c",
  "parent": {
   "type": "page_id",
   "page_id": "2e194183-19f3-8365-b5f1-015ca1e3434b"
  },
  "created_time": "2026-07-05T22:54:00.000Z",
