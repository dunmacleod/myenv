  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Unter einem Timeout versteht man das maximale Zeitfenster, das einer Systemkomponente f\u00fcr das Warten auf die Antwort einer anderen Komponente einger\u00e4umt wird.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Unter einem Timeout versteht man das maximale Zeitfenster, das einer Systemkomponente f\u00fcr das Warten auf die Antwort einer anderen Komponente einger\u00e4umt wird.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
