    "paragraph": {
     "rich_text": [
      {
       "type": "text",
       "text": {
        "content": "Kontextverw\u00e4sserung und Tool-\u00dcberladung sind die spezifischen Fehlerarten, die die Grenze dessen markieren, was ein Single-Agent-Chatflow zuverl\u00e4ssig bew\u00e4ltigen kann. Sie zu verstehen, ist ein Grund, ihn sorgf\u00e4ltig zu entwerfen.",
        "link": null
       },
       "annotations": {
        "bold": false,
        "italic": false,
        "strikethrough": false,
        "underline": false,
        "code": false,
        "color": "default"
       },
       "plain_text": "Kontextverw\u00e4sserung und Tool-\u00dcberladung sind die spezifischen Fehlerarten, die die Grenze dessen markieren, was ein Single-Agent-Chatflow zuverl\u00e4ssig bew\u00e4ltigen kann. Sie zu verstehen, ist ein Grund, ihn sorgf\u00e4ltig zu entwerfen.",
       "href": null
      }
     ],
