  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Timeouts are one of the most common failure points in orchestrated systems. They happen when one part of the system stops waiting before another part finishes working.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Timeouts are one of the most common failure points in orchestrated systems. They happen when one part of the system stops waiting before another part finishes working.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "38894183-19f3-80a8-9f1e-e6a910bdada8",
  "parent": {
   "type": "page_id",
