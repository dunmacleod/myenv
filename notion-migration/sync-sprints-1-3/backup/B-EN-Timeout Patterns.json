   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Agent workflows can take longer than normal web requests because they may involve several steps.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Agent workflows can take longer than normal web requests because they may involve several steps.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "38894183-19f3-80da-ae96-d566bb592bf7",
  "parent": {
   "type": "page_id",
   "page_id": "38894183-19f3-8054-8779-f668dd242f1e"
  },
  "created_time": "2026-06-23T18:14:00.000Z",
  "last_edited_time": "2026-06-23T18:14:00.000Z",
  "created_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "last_edited_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "An agent might need to classify the request, call a tool, wait for an external system, retrieve context, generate a response, or pass work to another agent. Each step adds time.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "An agent might need to classify the request, call a tool, wait for an external system, retrieve context, generate a response, or pass work to another agent. Each step adds time.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
