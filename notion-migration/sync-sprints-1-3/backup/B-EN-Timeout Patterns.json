   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Good timeout handling is not only about increasing a number. It is about understanding how long the workflow should reasonably take, where the timeout is enforced, and what should happen when work takes longer than expected.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Good timeout handling is not only about increasing a number. It is about understanding how long the workflow should reasonably take, where the timeout is enforced, and what should happen when work takes longer than expected.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
