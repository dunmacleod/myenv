  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The failure happens because the proxy, the backend service, the agent, and the user-facing interface do not all share the same expectation about response time.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The failure happens because the proxy, the backend service, the agent, and the user-facing interface do not all share the same expectation about response time.",
     "href": null
    }
   ],
   "icon": null,
