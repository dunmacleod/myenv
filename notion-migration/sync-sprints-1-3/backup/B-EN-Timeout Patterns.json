   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "In a simple app, 30 seconds may be enough. In an agent workflow, 30 seconds can be too short, especially when the workflow includes long model responses, tool calls, retrieval, or multi-agent handoffs.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "In a simple app, 30 seconds may be enough. In an agent workflow, 30 seconds can be too short, especially when the workflow includes long model responses, tool calls, retrieval, or multi-agent handoffs.",
     "href": null
    }
   ],
