 {
  "object": "block",
  "id": "38894183-19f3-80de-a74f-dd9156f6aeaa",
  "parent": {
   "type": "page_id",
   "page_id": "38894183-19f3-8054-8779-f668dd242f1e"
  },
  "created_time": "2026-06-23T18:14:00.000Z",
  "last_edited_time": "2026-06-23T18:14:00.000Z",
  "created_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "last_edited_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A timeout is the maximum amount of time one system component is willing to wait for another component to respond.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "A timeout is the maximum amount of time one system component is willing to wait for another component to respond.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "38894183-19f3-806c-be40-d7ccf60e8826",
  "parent": {
   "type": "page_id",
   "page_id": "38894183-19f3-8054-8779-f668dd242f1e"
  },
  "created_time": "2026-06-23T18:14:00.000Z",
  "last_edited_time": "2026-06-23T18:14:00.000Z",
  "created_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "last_edited_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "For example, imagine a Flowise agent deployed behind a cloud proxy. The user sends a request, the proxy forwards it to Flowise, and Flowise starts generating a response. If the proxy has a 30-second timeout, it will stop waiting after 30 seconds.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "For example, imagine a Flowise agent deployed behind a cloud proxy. The user sends a request, the proxy forwards it to Flowise, and Flowise starts generating a response. If the proxy has a 30-second timeout, it will stop waiting after 30 seconds.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
  "id": "38894183-19f3-8083-bc99-c221f48882f3",
  "parent": {
   "type": "page_id",
   "page_id": "38894183-19f3-8054-8779-f668dd242f1e"
  },
  "created_time": "2026-06-23T18:14:00.000Z",
  "last_edited_time": "2026-06-23T18:14:00.000Z",
  "created_by": {
   "object": "user",
   "id": "815cd27b-5ca8-4b38-8784-7f2f8565f656"
  },
  "last_edited_by": {
