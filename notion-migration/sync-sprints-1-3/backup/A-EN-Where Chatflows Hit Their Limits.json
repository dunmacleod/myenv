      "code": false,
      "color": "default"
     },
     "plain_text": "This is ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "tool bloat: ",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
