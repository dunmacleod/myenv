  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "The context window has not reached its hard token limit. But the model's attention has been stretched across too many competing inputs simultaneously  and reasoning quality has degraded as a result.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "The context window has not reached its hard token limit. But the model's attention has been stretched across too many competing inputs simultaneously  and reasoning quality has degraded as a result.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
