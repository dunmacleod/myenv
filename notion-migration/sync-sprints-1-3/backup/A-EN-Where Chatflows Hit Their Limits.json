 {
  "object": "block",
  "id": "a28717c0-5248-45ee-8ee2-08cca3cc50ee",
  "parent": {
   "type": "page_id",
   "page_id": "36894183-19f3-80a0-9d7a-db2e47c3849e"
  },
  "created_time": "2026-06-10T04:20:00.000Z",
  "last_edited_time": "2026-06-10T04:21:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "You experienced a version of this in the previous lesson when three vague tool descriptions caused routing failures. Imagine the same problem across twelve tools with overlapping descriptions. The model's routing becomes unreliable not because the descriptions are poorly written but because there are simply too many similar options to discriminate between consistently.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "You experienced a version of this in the previous lesson when three vague tool descriptions caused routing failures. Imagine the same problem across twelve tools with overlapping descriptions. The model's routing becomes unreliable not because the descriptions are poorly written but because there are simply too many similar options to discriminate between consistently.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
