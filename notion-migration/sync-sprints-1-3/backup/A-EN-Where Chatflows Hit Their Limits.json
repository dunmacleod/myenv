  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "But the executive team has a more ambitious question. Could the same architecture handle a full corporate loan application assessment by simultaneously analysing the client's financial position, evaluating regulatory compliance under current EU law, assessing credit risk against Contigo's internal models, and drafting the client communication summarising all three outcomes?",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "But the executive team has a more ambitious question. Could the same architecture handle a full corporate loan application assessment by simultaneously analysing the client's financial position, evaluating regulatory compliance under current EU law, assessing credit risk against Contigo's internal models, and drafting the client communication summarising all three outcomes?",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
