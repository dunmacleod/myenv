      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "This is called ",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": "context dilution",
      "link": null
     },
     "annotations": {
      "bold": true,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "context dilution",
     "href": null
    },
    {
     "type": "text",
     "text": {
      "content": " which is the degradation of reasoning quality as the volume of information in the context window increases beyond the model's effective attention capacity.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": " which is the degradation of reasoning quality as the volume of information in the context window increases beyond the model's effective attention capacity.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
