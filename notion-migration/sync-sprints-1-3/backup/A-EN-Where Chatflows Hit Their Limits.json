 {
  "object": "block",
  "id": "6509ebd8-0887-40c7-bfd1-ab66bfba6959",
  "parent": {
   "type": "page_id",
   "page_id": "36894183-19f3-80a0-9d7a-db2e47c3849e"
  },
  "created_time": "2026-06-10T04:20:00.000Z",
  "last_edited_time": "2026-06-10T04:20:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "For Contigo's complex application assessment, the agent begins confusing outputs from different analytical steps. It retrieves regulatory content when it should be running credit calculations. It generates the client summary before completing the compliance check. On complex multi-step applications, its error rate climbs significantly compared to simpler queries.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "For Contigo's complex application assessment, the agent begins confusing outputs from different analytical steps. It retrieves regulatory content when it should be running credit calculations. It generates the client summary before completing the compliance check. On complex multi-step applications, its error rate climbs significantly compared to simpler queries.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
  "object": "block",
