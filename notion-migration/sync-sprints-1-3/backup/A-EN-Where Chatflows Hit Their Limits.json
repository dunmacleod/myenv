 {
  "object": "block",
  "id": "6e9bc799-5e1e-45d5-b447-d61c5fb5db91",
  "parent": {
   "type": "page_id",
   "page_id": "36894183-19f3-80a0-9d7a-db2e47c3849e"
  },
  "created_time": "2026-06-10T04:20:00.000Z",
  "last_edited_time": "2026-06-10T04:20:00.000Z",
  "created_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "last_edited_by": {
   "object": "user",
   "id": "231d872b-594c-81f2-a375-0002b8783aca"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "A single agent processes every task through one context window. As the task grows in complexity, that context window fills with an increasing volume of tool outputs, retrieved chunks, intermediate reasoning steps, and conversation history. When the context becomes crowded, the model's ability to attend to earlier information degrades.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "A single agent processes every task through one context window. As the task grows in complexity, that context window fills with an increasing volume of tool outputs, retrieved chunks, intermediate reasoning steps, and conversation history. When the context becomes crowded, the model's ability to attend to earlier information degrades.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },
 {
